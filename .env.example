# Pollitik Manager service - environment variable names only.
# NEVER put real values in this file or commit a real .env file.
# Copy this to .env for local development (.env is gitignored) or set
# these directly in your deployment environment/secret manager.

# --- Anthropic authentication (read directly by claude-agent-sdk) --------
# Set exactly one of these. See docs/REMOTE_DEPLOYMENT.md for details on
# each option (standard API key vs Claude subscription OAuth token).
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# --- Pollitik service API authentication (MVP - see service/security.py) -
# Required for every mutating endpoint (POST /jobs, GET /jobs/{id},
# POST /jobs/{id}/run, POST /jobs/{id}/approve-write). GET /health does
# not require it. Generate with e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POLLITIK_API_TOKEN=

# --- Optional overrides ---------------------------------------------------
# Directory the SDK session uses as its working directory (defaults to the
# repository root - only change this if you know why).
# POLLITIK_PROJECT_DIR is not currently read directly; cwd is derived from
# service/config.py's own location. Left here as a placeholder in case a
# future deployment needs to override it explicitly.

# Where job records are stored (defaults to service_data/jobs/ under the repo root).
POLLITIK_JOB_STORE_DIR=

# Python interpreter used to invoke python/*.py pipeline scripts as
# subprocesses (defaults to "python3").
POLLITIK_PYTHON_BIN=

# Maximum agent turns per job (defaults to 40).
POLLITIK_MAX_TURNS=
